node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Android SDK command-line tools (adb, fastboot, etc.) - not project source
platform-tools/

# Firebase native config (contains project credentials) - never commit
google-services.json

# Moteur OCR copié depuis node_modules au build (scripts/copy-ocr-assets.mjs)
public/tesseract/

# Clé de signature debug : générée en CI depuis un secret, jamais versionnée
android/app/*.p12
android/app/*.keystore
android/app/*.jks

# Copie de travail locale de l'admin (peut contenir des liens/valeurs internes) : jamais commitée.
scripts/remote-config.seed.json

# Clé de compte de service Firebase (script d'administration) : ne JAMAIS commit.
scripts/*serviceAccount*.json
scripts/*service-account*.json
