rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidUserData(data) {
      return data.keys().hasAll(['state']) 
             && data.state is string;
    }

    match /user_data/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
                    && isValidId(userId)
                    && isValidUserData(incoming())
                    && incoming().keys().size() <= 2;
      allow update: if isSignedIn() && request.auth.uid == userId
                    && isValidId(userId)
                    && isValidUserData(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['state', 'updatedAt']);
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      // Photos synchronisées séparément du document principal (limite de 1 Mio/document Firestore) :
      // chaque photo est son propre petit document, pour ne jamais faire dépasser cette limite.
      match /photos/{photoId} {
        function isValidPhoto(data) {
          return data.keys().hasOnly(['data', 'updatedAt'])
                 && data.keys().hasAll(['data'])
                 && data.data is string
                 && data.data.size() < 1000000;
        }
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId
                     && isValidId(photoId)
                     && isValidPhoto(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Configuration distante publique (branding, liens utiles, codes USSD) : lecture libre, gérée à la main
    // depuis la console Firebase (aucune règle d'écriture ouverte). Absente = l'application utilise ses
    // valeurs par défaut intégrées, donc ce document est facultatif.
    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
