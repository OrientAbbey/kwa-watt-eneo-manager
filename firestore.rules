rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidUserData(data) {
      return data.keys().hasAll(['state']) 
             && data.state is string;
    }

    match /user_data/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
                    && isValidId(userId)
                    && isValidUserData(incoming())
                    && incoming().keys().size() <= 2;
      allow update: if isSignedIn() && request.auth.uid == userId
                    && isValidId(userId)
                    && isValidUserData(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['state', 'updatedAt']);
    }
  }
}
