    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.7.11",
    "@ionic/pwa-elements": "^3.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^5.2.0",
